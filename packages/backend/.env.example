# Convex backend

# Convex deployment URL used by clients
CONVEX_URL=

# Clerk (Convex auth integration)
CLERK_ISSUER_URL=
CLERK_JWKS_URL=
SEED_SECRET=

# Optional comma-separated Clerk user IDs for the platform privacy workspace.
# Set this on the Convex deployment.
PRIVACY_OPERATOR_CLERK_USER_IDS=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe portal subscription (set on the Convex deployment, never NEXT_PUBLIC_*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
# Optional override for the Full product in this Stripe environment.
# STRIPE_FULL_PRODUCT_ID=
APP_URL=https://admin.mybjjacademy.com.br
